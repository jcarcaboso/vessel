# Only a trusted TLS proxy should reach this server. Never expose it directly to the internet.
map $http_x_forwarded_proto $vessel_forwarded_proto {
    default $scheme;
    http http;
    https https;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    # API allows a 10 MiB image plus 64 KiB multipart overhead.
    client_max_body_size 10551296;
    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
    location ~ ^/(api|health)/ {
        proxy_pass ${VESSEL_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $vessel_forwarded_proto;
        proxy_set_header Connection "";
        # Market SSE must arrive incrementally, and must not idle out between observations.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
