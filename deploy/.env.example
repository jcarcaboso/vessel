# Copy to .env and chmod 600 before editing. Never commit or print the populated file.
# Required. Generate a hex password so connection-string delimiters cannot be injected.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
# Required. At least 32 random characters. This is the Vessel login token, not a venue token.
Vessel__Auth__Token=REPLACE_WITH_GENERATED_TOKEN
# Required. Generate a GUID once; preserve it when upgrading or restoring.
Vessel__Auth__OwnerId=REPLACE_WITH_GENERATED_GUID
# Optional display name.
Vessel__Auth__OwnerName=Owner
# Optional image version. Use a fixed release for predictable deployments.
VESSEL_VERSION=0.1.0
# Optional host IP and port. Keep loopback and put a TLS proxy in front.
VESSEL_WEB_BIND=127.0.0.1:8080
# Optional deterministic private subnet and gateway. Change both if these overlap another network.
VESSEL_NETWORK_SUBNET=172.30.86.0/24
VESSEL_NETWORK_GATEWAY=172.30.86.1
# Optional IP of the trusted TLS proxy as observed by web, normally the host network gateway.
# If changing the subnet, update this too. Trust only a proxy that overwrites incoming client headers.
VESSEL_TLS_PROXY_IP=172.30.86.1
# Optional server-side web proxy target. Never include credentials or publish API directly.
VESSEL_API_UPSTREAM=http://api:8080
# Optional, only with compose.credentials.yaml. Absolute host path, file mode 600, UID 1654.
# Generate outside any repository. Preserve old keys when restoring/upgrading.
# VESSEL_CREDENTIAL_KEYS_FILE=/opt/vessel-secrets/credential-keys.json
