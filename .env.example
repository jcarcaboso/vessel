# Local development only. Copy to .env and replace every placeholder.
# This file is consumed by Docker Compose, not bundled into the frontend.
POSTGRES_PASSWORD=replace-with-a-local-password
# Set the backend token in process environment, never a VITE_* variable.
# Vessel__Auth__Token and ConnectionStrings__Vessel are documented in
# docs/architecture/scaffold-contract.md.
Vessel__Auth__Token=replace-with-a-private-random-token

# Optional server-only encryption key ring for venue read-only tokens.
# Prefer a private key file initialized with scripts/credential_keys.py.
# See docs/architecture/venue-credentials.md for setup and optional Infisical retrieval.
# Only the path belongs here; keep the key file outside the repository and database.
# Vessel__Credentials__KeyFile=/absolute/private/path/credential-keys.json
# Alternatively use inline configuration, never together with KeyFile:
# Vessel__Credentials__ActiveKeyId=current
# Vessel__Credentials__Keys__current=replace-with-base64-32-byte-key
